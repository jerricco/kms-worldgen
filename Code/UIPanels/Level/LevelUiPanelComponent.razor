@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UIPanels.Level.Dock

@inherits PanelComponent

<root>
	@* TOP-LEFT: Tracking panel *@
	<div class="tracking-panel">
		<Tracking.SimControlPanel></Tracking.SimControlPanel>
		<Tracking.AeonsPanel></Tracking.AeonsPanel>
		<Tracking.ResourceBayPanel></Tracking.ResourceBayPanel>
	</div>

	@* TOP-RIGHT: Information & tools panel *@
	<div class="info-tools-panel">
		<Tools.OverlaysPanel></Tools.OverlaysPanel>
		<Tools.MenuToolPanel></Tools.MenuToolPanel>
		<Tools.GameAlertsPanel></Tools.GameAlertsPanel>
		<Tools.WorldStatePanel></Tools.WorldStatePanel>
		<Tools.DebugToolsPanel></Tools.DebugToolsPanel>
		<Tools.ToolbarPanel></Tools.ToolbarPanel>
	</div>

	@* BOTTOM-LEFT: Menu panel *@
	<div class="menu-panel">
		<Dock.DockMenuPanel></Dock.DockMenuPanel>
	</div>

	@* BOTTOM-RIGHT: Notification panel *@
	<div class="notification-panel">
		<Dock.GameNotificationsPanel></Dock.GameNotificationsPanel>
	</div>
	@* OVERLAY: Open widgets *@
	@* OVERLAY: Dock window panel *@
	@* OVERLAY: Full-window panel *@
</root>

@code
{

	[Property, TextArea] public string MyStringValue { get; set; } = "Hello World!";

	/// <summary>
	/// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
	protected override int BuildHash() => System.HashCode.Combine(this.MyStringValue );
}
