@using Sandbox;
@using Sandbox.UI;
@using Aeons;
@inherits PanelComponent
@namespace Sandbox

<root>
    @if (Settings != null)
    {
        <div class="debug-menu">
            <h2>Generation Settings</h2>
            <div class="stat-row">
                <span class="label">SeedText:</span>
                <span class="value">@Settings.SeedText</span>
            </div>
            <div class="stat-row">
                <span class="label">Grid Dimensions:</span>
                <span class="value">@Settings.WorldWidth x @Settings.WorldHeight</span>
            </div>
            <div class="stat-row">
                <span class="label">Voronoi Cell Search Size:</span>
                <span class="value">@Settings.CellGridSize</span>
            </div>
            <div class="stat-row">
                <span class="label">Chunk Size:</span>
                <span class="value">@Settings.ChunkGridSize</span>
            </div>
            <div class="stat-row">
                <span class="label">Continent Frag Factor:</span>
                <span class="value">@Settings.ContinentalFragFactor.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Macro Bay Frequency:</span>
                <span class="value">@Settings.MacroBayFrequency.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Macro Bay Intensity:</span>
                <span class="value">@Settings.MacroBayIntensity.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Ocean Clamp:</span>
                <span class="value">@Settings.OceanClamp.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Noise Scale:</span>
                <span class="value">@Settings.MacroScale.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Squish Factor:</span>
                <span class="value">@Settings.SquishFactor.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Stretch X:</span>
                <span class="value">@Settings.StretchX.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Stretch Y:</span>
                <span class="value">@Settings.StretchY.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Abyssal Level:</span>
                <span class="value">@Settings.AbyssalLevel.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Trench Level:</span>
                <span class="value">@Settings.TrenchLevel.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">DeepOcean Level:</span>
                <span class="value">@Settings.DeepOceanLevel.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Ocean Level:</span>
                <span class="value">@Settings.OceanLevel.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Sea Level:</span>
                <span class="value">@Settings.SeaLevel.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Beach Level:</span>
                <span class="value">@Settings.BeachLevel.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Plain Level:</span>
                <span class="value">@Settings.PlainLevel.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Hill Level:</span>
                <span class="value">@Settings.HillLevel.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Mointain Level:</span>
                <span class="value">@Settings.MointainLevel.ToString("F3")</span>
            </div>
            <div class="stat-row">
                <span class="label">Peak Level:</span>
                <span class="value">@Settings.PeakLevel.ToString("F3")</span>
            </div>

            
            <h2 class="subhead">Generation Meta</h2>
            <div class="stat-row">
                <span class="label">Total Tiles:</span>
                <span class="value">@Settings.TotalTiles</span>
            </div>
            <div class="stat-row">
                <span class="label">Total Chunks:</span>
                <span class="value">@Settings.TotalChunks</span>
            </div>
            <div class="stat-row">
                <span class="label">Half Width:</span>
                <span class="value">@Settings.HalfWidth</span>
            </div>
            <div class="stat-row">
                <span class="label">Half Height:</span>
                <span class="value">@Settings.HalfHeight</span>
            </div>
        </div>
    }
    else
    {
        <div class="debug-menu error">
            <p>Searching for GenerationSettings serializable object...</p>
        </div>
    }

    @if (Generator != null)
    {
    <div class="debug-menu">
            <div class="stat-row">
                <span class="label">RandomAngle:</span>
                <span class="value">@Generator.RandomAngle</span>
            </div>
            <div class="stat-row">
                <span class="label">OffsetX:</span>
                <span class="value">@Generator.OffsetX</span>
            </div>
            <div class="stat-row">
                <span class="label">OffsetY:</span>
                <span class="value">@Generator.OffsetY</span>
            </div>
            <div class="stat-row">
                <span class="label">CosA:</span>
                <span class="value">@Generator.CosA</span>
            </div>
            <div class="stat-row">
                <span class="label">SinA:</span>
                <span class="value">@Generator.SinA</span>
            </div>
    </div>
    }
    else
    {
        <div class="debug-menu error">
            <p>Searching for MapGenerator component...</p>
        </div>
    }
</root>

@code
{
    [Property] public GenerationSettings Settings { get; set; }
    [Property] public MapGenerator Generator { get; set; }

    protected override void OnStart()
    {
        base.OnStart();
        // get the active settings component
        Generator = Scene.GetAllComponents<MapGenerator>().FirstOrDefault();
    }

	/// <summary>
	/// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
	protected override int BuildHash() {
        return System.HashCode.Combine(Settings, Generator);
    }
}