@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root>
	@* SCREEN TOP: Takes a dynamic area at the top of the screen to fill down to SCREEN BOTTOM *@
	<div class="screen-top">
		@* TOP-LEFT: Tracking panel *@
		<div class="tracking-panel">
			<SimControlPanel></SimControlPanel>
			<AeonsPanel></AeonsPanel>
			<ResourceBayPanel></ResourceBayPanel>
		</div>

		@* TOP-RIGHT: Information & tools panel *@
		<div class="info-tools-panel">
			
		</div>
	</div>

	@* SCREEN BOTTOM: Takes a fixed bottom % of the screenspace *@
	<div class="screen-bottom">
		@* BOTTOM-LEFT: Menu panel *@
		<div class="menu-panel"></div>

		@* BOTTOM-RIGHT: Notification panel*@
		<div class="notification-panel"></div>
	</div>

	@* OVERLAY: Open widgets *@
	@* OVERLAY: Dock window panel *@
	@* OVERLAY: Full-window panel *@
</root>

@code
{

	[Property, TextArea] public string MyStringValue { get; set; } = "Hello World!";

	/// <summary>
	/// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
	protected override int BuildHash() => System.HashCode.Combine( MyStringValue );
}
